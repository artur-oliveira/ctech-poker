{
  "name": "ctech-poker-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3003",
    "dev:mock": "NEXT_PUBLIC_MOCK_API=true next dev --port 3003",
    "og:preview": "node tools/og-preview/server.mjs",
    "og:capture": "node --experimental-strip-types scripts/capture-og-images.mjs",
    "screenshots:capture": "node --experimental-strip-types scripts/capture-og-images.mjs --all",
    "build": "next build && node scripts/strip-inline-scripts.mjs",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "cards:variants": "node --experimental-strip-types scripts/generate-card-variants.ts",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "bundle:pin": "node scripts/check-bundle-budget.mjs --update",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@aoctech/auth-client": "^1.2.0",
    "@aoctech/ws-client": "^1.3.0",
    "@base-ui/react": "^1.8.0",
    "@bufbuild/protobuf": "^2.14.1",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-virtual": "^3.14.10",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "ts-proto": "^2.12.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
