{
  "name": "ctech-poker-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3003",
    "dev:mock": "NEXT_PUBLIC_MOCK_API=true next dev --port 3003",
    "og:preview": "node tools/og-preview/server.mjs",
    "og:capture": "node --experimental-strip-types scripts/capture-og-images.mjs",
    "screenshots:capture": "node --experimental-strip-types scripts/capture-og-images.mjs --all",
    "build": "next build && node scripts/strip-inline-scripts.mjs",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "cards:variants": "node --experimental-strip-types scripts/generate-card-variants.ts",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "bundle:pin": "node scripts/check-bundle-budget.mjs --update",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@aoctech/auth-client": "^1.3.0",
    "@aoctech/ws-client": "^1.3.0",
    "@base-ui/react": "^1.8.0",
    "@bufbuild/protobuf": "^2",
    "@hookform/resolvers": "^5",
    "@tanstack/react-query": "^5",
    "@tanstack/react-virtual": "^3",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1",
    "next": "^16",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7",
    "shadcn": "^4",
    "tailwind-merge": "^3",
    "zod": "^4"
  },
  "devDependencies": {
    "@playwright/test": "^1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5",
    "eslint": "^10",
    "eslint-config-next": "^16",
    "jsdom": "^30",
    "tailwindcss": "^4",
    "ts-proto": "^2",
    "typescript": "^6",
    "vitest": "^5"
  }
}
