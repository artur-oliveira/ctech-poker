  "private": true,
  "scripts": {
    "dev": "next dev --port 3003",
    "dev:mock": "NEXT_PUBLIC_MOCK_API=true next dev --port 3003",
    "og:preview": "node tools/og-preview/server.mjs",
    "og:capture": "node --experimental-strip-types scripts/capture-og-images.mjs",
