bin/
# cdk/bin holds the CDK app entrypoint (source, not build output) — the bare
# bin/ rule above (Go build output) would otherwise swallow it silently.
!cdk/bin/
node_modules/
cdk.out/
cli/poker
*.log
.DS_Store
api/archiver
out/
.next/
coverage/
.lighthouseci/
api/dist/
.env
.env.local
.idea/
.superpowers/
api/tablecleanup
api/reconcilie
api/server
*.har
*.d.ts
cdk/*/*.js
.claude/
.codex/
.impeccable/config.local.json
cli/.impeccable/critique/*.md
